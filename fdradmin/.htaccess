# Matikan listing folder
Options -Indexes

# Blokir akses langsung ke file konfigurasi autentikasi
<Files "auth_config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

